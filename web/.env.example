# Postgres (PostGIS) holding Matka's data. Migrations run on start.
DATABASE_URL=postgresql://matka:matka@localhost:5544/matka

# Public URL browsers and phones use to reach this instance (https in production).
APP_URL=http://localhost:3000

# Signs the login-state cookie and encrypts stored Immich keys. Keep stable.
# Generate with: openssl rand -base64 48
MATKA_SECRET=

# How people sign in: oidc (default, the provider below) or key (one owner and a
# long login key, for instances without an identity provider; see docs/DEPLOY.md).
# MATKA_AUTH=key
# MATKA_LOGIN_KEY=        # >= 32 chars: openssl rand -base64 36
# Authentik OIDC provider. Redirect URI to register: <APP_URL>/auth/callback
OIDC_ISSUER=https://auth.example.com/application/o/matka/
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
# Who may sign in: comma-separated OIDC `sub` values and/or emails, or * to let
# Authentik's application policy decide. Empty = nobody.
MATKA_ALLOWED_USERS=

# Default time zone for new users (each user can change theirs in Settings).
MATKA_DEFAULT_TIMEZONE=Europe/Helsinki

# Self-hosted Photon for place names (optional), e.g. http://photon:2322
PHOTON_URL=

# Sites that may show the map and day map in an <iframe> (optional): space-separated
# origins, e.g. https://app.example.com. Empty = nothing can frame Matka (the default).
# See docs/DEPLOY.md → "Embedding the map in another site".
# MATKA_FRAME_ANCESTORS=

# AI place picker (optional; each user turns it on in Settings): picks between
# several nearby shops/venues from the visit pattern, with a small Claude model on
# shared accounts from a claude-accounts service. Hidden while either is unset.
# CLAUDE_ACCOUNTS_URL=http://claude-accounts:8080
# CLAUDE_ACCOUNTS_TOKEN=
# Model and limits (defaults shown):
# MATKA_AI_MODEL=claude-haiku-5-5
# MATKA_AI_REQUESTS_PER_DAY=40
# MATKA_AI_REQUESTS_PER_TICK=1
# MATKA_AI_TIMEOUT_MS=60000

# One-time Dawarich history import, run automatically by the worker until done
# (resumable, read-only). A read-only role is enough, e.g. matka_ro. Afterwards
# points Dawarich records later are copied daily into gaps only (no point within
# 10 min of one Matka recorded); Settings has a "Check Dawarich" button.
# DAWARICH_IMPORT_URL=postgresql://matka_ro:<pw>@dawarich_db:5432/dawarich_development
# Who gets the history (email or OIDC sub; they must have signed in once).
# Defaults to the owner in key mode.
# DAWARICH_IMPORT_TO=
# Only if Dawarich has several users: whose points to copy.
# DAWARICH_IMPORT_USER=
# Background processing worker: on by default; set to off on extra replicas if you like.
# MATKA_WORKER=off

# Development only (ignored when NODE_ENV=production): skip login entirely.
# MATKA_AUTH_DISABLED=1

# Immich is configured per user in Settings, not here.
