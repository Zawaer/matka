# Postgres (PostGIS) holding Matka's data.
DATABASE_URL=postgresql://matka:matka@localhost:5544/matka
MATKA_USER_ID=1

# Public URL browsers and phones use to reach this instance (https in production).
APP_URL=http://localhost:3000

# Signs session cookies. Generate with: openssl rand -base64 48
SESSION_SECRET=

# Authentik OIDC provider. Redirect URI to register: <APP_URL>/auth/callback
OIDC_ISSUER=https://auth.example.com/application/o/matka/
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
# Who may sign in: comma-separated OIDC `sub` values and/or emails. Empty = nobody.
MATKA_ALLOWED_USERS=

# Development only (ignored when NODE_ENV=production): skip login entirely.
# MATKA_AUTH_DISABLED=1

# Immich photo galleries (optional).
IMMICH_URL=
IMMICH_API_KEY=
