# Postgres (PostGIS) holding Matka's data. Migrations run on start.
DATABASE_URL=postgresql://matka:matka@localhost:5544/matka

# Public URL browsers and phones use to reach this instance (https in production).
APP_URL=http://localhost:3000

# Signs the login-state cookie and encrypts stored Immich keys. Keep stable.
# Generate with: openssl rand -base64 48
MATKA_SECRET=

# Authentik OIDC provider. Redirect URI to register: <APP_URL>/auth/callback
OIDC_ISSUER=https://auth.example.com/application/o/matka/
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
# Who may sign in: comma-separated OIDC `sub` values and/or emails, or * to let
# Authentik's application policy decide. Empty = nobody.
MATKA_ALLOWED_USERS=

# Default time zone for new users (each user can change theirs in Settings).
MATKA_DEFAULT_TIMEZONE=Europe/Helsinki

# Self-hosted Photon for place names (optional), e.g. http://photon:2322
PHOTON_URL=

# Background processing worker: on by default; set to off on extra replicas if you like.
# MATKA_WORKER=off

# Development only (ignored when NODE_ENV=production): skip login entirely.
# MATKA_AUTH_DISABLED=1

# Immich is configured per user in Settings, not here.
