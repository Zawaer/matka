{
  "expo": {
    "name": "Matka",
    "slug": "mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "fi.otamaps.matka",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Matka records your location to build your timeline.",
        "NSLocationAlwaysAndWhenInUseUsageDescription": "Matka records your location in the background to build your timeline.",
        "UIBackgroundModes": [
          "location"
        ]
      }
    },
    "android": {
      "package": "fi.otamaps.matka",
      "adaptiveIcon": {
        "backgroundColor": "#0b1020",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "ACCESS_BACKGROUND_LOCATION",
        "FOREGROUND_SERVICE",
        "FOREGROUND_SERVICE_LOCATION",
        "POST_NOTIFICATIONS"
      ]
    },
    "plugins": [
      [
        "expo-location",
        {
          "isAndroidBackgroundLocationEnabled": true,
          "isAndroidForegroundServiceEnabled": true,
          "locationAlwaysAndWhenInUsePermission": "Matka records your location in the background to build your timeline."
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true
          }
        }
      ],
      "./plugins/withLowMemoryGradle.js",
      "./plugins/withDebugUserCerts.js"
    ],
    "web": {
      "favicon": "./assets/favicon.png"
    }
  }
}
